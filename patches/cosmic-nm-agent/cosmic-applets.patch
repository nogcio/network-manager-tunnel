index 0000000..cb2fa61
--- /dev/null
+++ b/cosmic-applet-network/src/vpn_store.rs
@@ -0,0 +1,323 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Standard NM VPN credential storage owned by the existing desktop agent.
+//! No NM profile database, plaintext fallback or application-managed encryption.
+use std::collections::{HashMap, HashSet};
+
+use nmrs::agent::{
+    SecretAgentFlags, SecretConnection, SecretRequest, SecretStore, SecretStoreError,
+};
+use secret_service::{EncryptionType, SecretService};
+use tokio::sync::Mutex;
+
+#[derive(Default)]
+pub(crate) struct VpnStore {
+    // Serialize store mutations and reads; never hold this across a VPN prompt.
+    // Secret Service dispatch may already commit when a deadline drops a future.
+    serial: Mutex<()>,
+}
+
+fn failed() -> SecretStoreError {
+    SecretStoreError::default()
+}
+
+fn text(
+    connection: &SecretConnection,
+    section: &str,
+    key: &str,
+) -> Result<String, SecretStoreError> {
+    connection
+        .get(section)
+        .and_then(|s| s.get(key))
+        .and_then(|v| <&str>::try_from(v).ok())
+        .map(str::to_owned)
+        .ok_or_else(failed)
+}
+
+fn dictionary(
+    connection: &SecretConnection,
+    key: &str,
+) -> Result<HashMap<String, String>, SecretStoreError> {
+    connection
+        .get("vpn")
+        .and_then(|s| s.get(key))
+        .map(|v| {
+            v.try_clone()
+                .map_err(|_| failed())
+                .and_then(|v| HashMap::try_from(v).map_err(|_| failed()))
+        })
+        .unwrap_or_else(|| Ok(HashMap::new()))
+}
+
+fn key_valid(key: &str) -> bool {
+    !key.is_empty() && key.len() <= 128 && key.bytes().all(|b| b.is_ascii_graphic())
+}
+
+fn agent_owned(data: &HashMap<String, String>, key: &str) -> Result<bool, SecretStoreError> {
+    match data
+        .get(&format!("{key}-flags"))
+        .map(String::as_str)
+        .unwrap_or("0")
+    {
+        "1" => Ok(true),
+        "0" | "2" | "3" | "4" | "5" | "6" | "7" => Ok(false),
+        _ => Err(failed()),
+    }
+}
+
+fn attributes<'a>(
+    uuid: &'a str,
+    service: Option<&'a str>,
+    key: Option<&'a str>,
+) -> HashMap<&'a str, &'a str> {
+    let mut attrs = HashMap::from([
+        ("xdg:schema", "org.freedesktop.NetworkManager.Connection"),
+        ("connection-uuid", uuid),
+        ("setting-name", "vpn"),
+    ]);
+    if let Some(service) = service {
+        attrs.insert("vpn-service-type", service);
+    }
+    if let Some(key) = key {
+        attrs.insert("setting-key", key);
+    }
+    attrs
+}
+
+fn identity(connection: &SecretConnection) -> Result<(String, String), SecretStoreError> {
+    let uuid = text(connection, "connection", "uuid")?;
+    uuid::Uuid::parse_str(&uuid).map_err(|_| failed())?;
+    let service = text(connection, "vpn", "service-type")?;
+    if service.is_empty() || service.len() > 255 {
+        return Err(failed());
+    }
+    Ok((uuid, service))
+}
+
+impl VpnStore {
+    /// Return only agent-owned requested keys. REQUEST_NEW bypasses storage;
+    /// locked storage never prompts unless NM explicitly allows interaction.
+    /// Errors are redacted by the caller and never select another store.
+    pub(crate) async fn lookup(
+        &self,
+        req: &SecretRequest,
+    ) -> Result<Option<HashMap<String, String>>, SecretStoreError> {
+        let nmrs::agent::SecretSetting::Vpn { service_type, .. } = &req.setting else {
+            return Ok(None);
+        };
+        if req.flags.contains(SecretAgentFlags::REQUEST_NEW) {
+            return Ok(None);
+        }
+        uuid::Uuid::parse_str(&req.connection_uuid).map_err(|_| failed())?;
+        let hints: Vec<_> = req
+            .hints
+            .iter()
+            .filter(|s| !s.starts_with("x-vpn-message:"))
+            .collect();
+        if hints.len() > 32 || hints.iter().any(|key| !key_valid(key)) {
+            return Err(failed());
+        }
+        let mut wanted = HashSet::new();
+        if hints.is_empty() {
+            for key in req.vpn_data.keys().filter_map(|s| s.strip_suffix("-flags")) {
+                if !key_valid(key) {
+                    return Err(failed());
+                }
+                if agent_owned(&req.vpn_data, key)? {
+                    wanted.insert(key.to_owned());
+                }
+            }
+        } else {
+            for key in hints {
+                if !agent_owned(&req.vpn_data, key)? {
+                    return Ok(None);
+                }
+                wanted.insert(key.clone());
+            }
+        }
+        if wanted.is_empty() {
+            return Ok(None);
+        }
+        if wanted.len() > 32 {
+            return Err(failed());
+        }
+        let _guard = self.serial.lock().await;
+        let service = SecretService::connect(EncryptionType::Dh)
+            .await
+            .map_err(|_| failed())?;
+        let collection = service
+            .get_default_collection()
+            .await
+            .map_err(|_| failed())?;
+        if collection.is_locked().await.map_err(|_| failed())? {
+            if !req.flags.contains(SecretAgentFlags::ALLOW_INTERACTION) {
+                return Ok(None);
+            }
+            collection.unlock().await.map_err(|_| failed())?;
+        }
+        let mut result = HashMap::new();
+        for key in wanted {
+            let items = collection
+                .search_items(attributes(
+                    &req.connection_uuid,
+                    Some(service_type),
+                    Some(&key),
+                ))
+                .await
+                .map_err(|_| failed())?;
+            // Ambiguous duplicates are not arbitrarily selected.
+            if items.is_empty() {
+                return Ok(None);
+            }
+            if items.len() != 1 {
+                return Err(failed());
+            }
+            let bytes = items[0].get_secret().await.map_err(|_| failed())?;
+            if bytes.is_empty() || bytes.len() > 4096 {
+                return Err(failed());
+            }
+            result.insert(key, String::from_utf8(bytes).map_err(|_| failed())?);
+        }
+        Ok(Some(result))
+    }
+}
+
+#[async_trait::async_trait]
+impl SecretStore for VpnStore {
+    async fn save(&self, connection: &SecretConnection) -> Result<(), SecretStoreError> {
+        if text(connection, "connection", "type")? != "vpn" {
+            return Ok(());
+        }
+        let (uuid, vpn_service) = identity(connection)?;
+        let data = dictionary(connection, "data")?;
+        let secrets = dictionary(connection, "secrets")?;
+        if secrets.values().map(String::len).sum::<usize>() > 64 * 1024 {
+            return Err(failed());
+        }
+        let keys: HashSet<_> = secrets
+            .keys()
+            .map(String::as_str)
+            .chain(data.keys().filter_map(|key| key.strip_suffix("-flags")))
+            .collect();
+        if keys.len() > 32 {
+            return Err(failed());
+        }
+        // Validate the complete payload before any Secret Service operation.
+        let mut operations = Vec::new();
+        for key in keys {
+            if !key_valid(key) {
+                return Err(failed());
+            }
+            let owned = agent_owned(&data, key)?;
+            let secret = secrets.get(key);
+            if secret.is_some_and(|s| s.is_empty() || s.len() > 4096) {
+                return Err(failed());
+            }
+            operations.push((key, owned, secret));
+        }
+        if operations.is_empty() {
+            return Ok(());
+        }
+        let _guard = self.serial.lock().await;
+        let service = SecretService::connect(EncryptionType::Dh)
+            .await
+            .map_err(|_| failed())?;
+        let collection = service
+            .get_default_collection()
+            .await
+            .map_err(|_| failed())?;
+        collection.unlock().await.map_err(|_| failed())?;
+        for (key, owned, secret) in operations {
+            let attrs = attributes(&uuid, Some(&vpn_service), Some(key));
+            if !owned {
+                for item in collection.search_items(attrs).await.map_err(|_| failed())? {
+                    item.delete().await.map_err(|_| failed())?;
+                }
+            } else if let Some(secret) = secret {
+                collection
+                    .create_item(
+                        "NetworkManager VPN credential",
+                        attrs,
+                        secret.as_bytes(),
+                        true,
+                        "text/plain",
+                    )
+                    .await
+                    .map_err(|_| failed())?;
+            }
+        }
+        Ok(())
+    }
+
+    async fn delete(&self, connection: &SecretConnection) -> Result<(), SecretStoreError> {
+        if text(connection, "connection", "type")? != "vpn" {
+            return Ok(());
+        }
+        let (uuid, _) = identity(connection)?;
+        let _guard = self.serial.lock().await;
+        let service = SecretService::connect(EncryptionType::Dh)
+            .await
+            .map_err(|_| failed())?;
+        let collection = service
+            .get_default_collection()
+            .await
+            .map_err(|_| failed())?;
+        collection.unlock().await.map_err(|_| failed())?;
+        for item in collection
+            .search_items(attributes(&uuid, None, None))
+            .await
+            .map_err(|_| failed())?
+        {
+            item.delete().await.map_err(|_| failed())?;
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_explicit_agent_owned_flags_permit_persistence_or_lookup() {
+        assert!(!agent_owned(&HashMap::new(), "uuid").unwrap());
+        for flags in 0..=7 {
+            assert_eq!(
+                agent_owned(
+                    &HashMap::from([("uuid-flags".into(), flags.to_string())]),
+                    "uuid"
+                )
+                .unwrap(),
+                flags == 1
+            );
+        }
+        for flags in ["-1", "8", "", "garbage"] {
+            assert!(
+                agent_owned(
+                    &HashMap::from([("uuid-flags".into(), flags.into())]),
+                    "uuid"
+                )
+                .is_err()
+            );
+        }
+        let attrs = attributes(
+            "synthetic-profile-uuid",
+            Some("synthetic.service"),
+            Some("uuid"),
+        );
+        assert_eq!(
+            attrs.get("connection-uuid"),
+            Some(&"synthetic-profile-uuid")
+        );
+        assert_eq!(attrs.get("vpn-service-type"), Some(&"synthetic.service"));
+        assert_eq!(attrs.get("setting-key"), Some(&"uuid"));
+        assert!(!key_valid(""));
+        assert!(!key_valid("bad\nkey"));
+    }
+
+    #[tokio::test]
+    async fn invalid_store_payload_rejects_before_opening_the_keyring() {
+        let store = VpnStore::default();
+        assert!(store.save(&HashMap::new()).await.is_err());
+        assert!(store.delete(&HashMap::new()).await.is_err());
+    }
