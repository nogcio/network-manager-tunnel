diff --git a/tests/qtest/tco-test.c b/tests/qtest/tco-test.c
index 20ccefa..1517d83 100644
--- a/tests/qtest/tco-test.c
+++ b/tests/qtest/tco-test.c
@@ -247,6 +247,63 @@ static QDict *get_watchdog_action(const TestData *td)
     return data;
 }
 
+/* S3 must not remove the I/O decode used by the OS's keepalive writes. */
+static void test_tco_s3_keepalive_and_expiry(void)
+{
+    TestData td;
+    const uint16_t ticks = TCO_SECS_TO_TICKS(16);
+    QDict *action;
+    int i;
+
+    td.args = "-watchdog-action pause -nic none";
+    td.noreboot = false;
+    test_init(&td);
+    stop_tco(&td);
+    clear_tco_status(&td);
+    reset_on_second_timeout(&td, true);
+    set_tco_timeout(&td, ticks);
+    start_tco(&td);
+
+    qtest_outw(td.qts, PM_IO_BASE_ADDR + ICH9_PMIO_PM1_CNT,
+               ACPI_BITMASK_SLEEP_ENABLE | (1 << 10));
+    qtest_qmp_eventwait(td.qts, "SUSPEND");
+    qtest_qmp_assert_success(td.qts, "{ 'execute': 'system_wakeup' }");
+    qtest_qmp_eventwait(td.qts, "WAKEUP");
+
+    g_assert_cmphex(qpci_config_readl(td.dev, ICH9_LPC_PMBASE), ==,
+                    PM_IO_BASE_ADDR | 1);
+    g_assert_cmphex(qpci_config_readb(td.dev, ICH9_LPC_ACPI_CTRL), ==, 0x80);
+    g_assert_cmphex(qpci_config_readl(td.dev, ICH9_LPC_RCBA), ==,
+                    RCBA_BASE_ADDR | 1);
+    g_assert_cmpint(qpci_io_readw(td.dev, td.tco_io_bar, TCO_TMR), ==, ticks);
+    g_assert_cmpint(qtest_readl(td.qts, RCBA_BASE_ADDR + ICH9_CC_GCS) &
+                   ICH9_CC_GCS_NO_REBOOT, ==, 0);
+
+    /* Service the same watchdog beyond its two-period expiry window. */
+    for (i = 0; i < 6; i++) {
+        qtest_clock_step(td.qts, ticks * TCO_TICK_NSEC / 2);
+        load_tco(&td);
+    }
+    g_assert_cmpint(qpci_io_readw(td.dev, td.tco_io_bar, TCO1_STS) &
+                   TCO_TIMEOUT, ==, 0);
+
+    /* It must still fire when keepalives cease; this is not a disable fix. */
+    qtest_clock_step(td.qts, ticks * TCO_TICK_NSEC * 2);
+    action = get_watchdog_action(&td);
+    g_assert_cmpstr(qdict_get_str(action, "action"), ==, "pause");
+    qobject_unref(action);
+    stop_tco(&td);
+    qtest_qmp_assert_success(td.qts, "{ 'execute': 'system_reset' }");
+    qtest_qmp_eventwait(td.qts, "RESET");
+    g_assert_cmphex(qpci_config_readl(td.dev, ICH9_LPC_PMBASE), ==,
+                    ICH9_LPC_PMBASE_DEFAULT);
+    g_assert_cmphex(qpci_config_readb(td.dev, ICH9_LPC_ACPI_CTRL), ==,
+                    ICH9_LPC_ACPI_CTRL_DEFAULT);
+    g_assert_cmphex(qpci_config_readl(td.dev, ICH9_LPC_RCBA), ==,
+                    ICH9_LPC_RCBA_DEFAULT);
+    test_end(&td);
+}
+
