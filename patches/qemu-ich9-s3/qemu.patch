+    qtest_add_func("tco/s3/keepalive-and-expiry", test_tco_s3_keepalive_and_expiry);
     qtest_add_func("tco/timeout/no_action", test_tco_timeout);
     qtest_add_func("tco/timeout/no_action/max", test_tco_max_timeout);
