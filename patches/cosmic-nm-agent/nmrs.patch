@@ -0,0 +1,30 @@
+//! Optional consumer-owned durable storage, invoked before acknowledging NM.
+use std::collections::HashMap;
+
+/// NM's settings dictionary. Contains credentials; never log or persist wholesale.
+pub type SecretConnection = HashMap<String, HashMap<String, zvariant::OwnedValue>>;
+
+/// A redacted failure to commit a credential-store operation.
+#[derive(Debug, Default, thiserror::Error)]
+#[error("credential store operation failed")]
+#[non_exhaustive]
+pub struct SecretStoreError;
+
+/// Persistence supplied by the desktop agent, not by nmrs.
+///
+/// Calls are authenticated against the current NM bus owner and bounded by the
+/// agent response deadline. Implementations must honor per-secret NM flags and
+/// never fall back to a different store. Save receives the original NM payload;
+/// Delete receives connection identity even after the NM object disappears.
+/// A successful return must mean the operation completed, not merely queued.
+/// On deadline/cancellation the future is dropped; an already dispatched store
+/// write may have completed, so consumers must make replacements idempotent.
+#[async_trait::async_trait]
+pub trait SecretStore: Send + Sync {
+    /// Persist only agent-owned secrets from this payload.
+    #[must_use = "the credential store operation must be awaited"]
+    async fn save(&self, connection: &SecretConnection) -> Result<(), SecretStoreError>;
+    /// Delete this connection's agent-owned secrets, without consulting its path.
+    #[must_use = "the credential deletion must be awaited"]
+    async fn delete(&self, connection: &SecretConnection) -> Result<(), SecretStoreError>;
+}
