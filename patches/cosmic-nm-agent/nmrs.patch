+
+async fn authorize(
+    bus: &zbus::Connection,
+    header: &zbus::message::Header<'_>,
+) -> Result<(), SecretAgentDBusError> {
+    let denied = || SecretAgentDBusError::PermissionDenied("NetworkManager owner required".into());
+    let lookup = async {
+        let proxy = zbus::fdo::DBusProxy::new(bus).await.map_err(|_| denied())?;
+        let name = zbus::names::BusName::try_from("org.freedesktop.NetworkManager")
+            .map_err(|_| denied())?;
+        proxy.get_name_owner(name).await.map_err(|_| denied())
+    };
+    futures::pin_mut!(lookup);
+    let owner =
+        match future::select(lookup, futures_timer::Delay::new(Duration::from_secs(5))).await {
+            Either::Left((result, _)) => result?,
+            Either::Right(_) => return Err(denied()),
+        };
+    if header
+        .sender()
+        .is_some_and(|sender| sender.as_str() == owner.as_str())
+    {
+        Ok(())
+    } else {
+        Err(denied())
+    }
+}
